#!/bin/sh /etc/rc.common
#
# Custom V2Ray/Xray Init Script for OpenWrt
# Pure TProxy + Strict Blacklist/Whitelist Mode + Extreme Performance Edition
#

START=99
USE_PROCD=1

NAME=v2ray

FILE_V2RAY_DNSMASQ=/tmp/dnsmasq.d/$NAME
FILE_V2RAY_DNSMASQ_CACHE=/tmp/$NAME.dnsmasq.cache

CORE=
CORE_VER=

NFT_BIN=$(command -v nft)

IPSET_DST_PROXY_V4=v2ray_dst_proxy_v4
IPSET_DST_PROXY_V6=v2ray_dst_proxy_v6
IPSET_SRC_DIRECT_V4=v2ray_src_direct_v4
IPSET_DST_DIRECT_V4=v2ray_dst_direct_v4
IPSET_DST_DIRECT_V6=v2ray_dst_direct_v6

TRANSPARENT_PROXY_EXPECTED=0
TRANSPARENT_PROXY_PORT=
TRANSPARENT_PROXY_ADDITION=
TRANSPARENT_PROXY_IPV6=0
DNSMASQ_RESTART_EXPECTED=0

_log() {
	local level="$1" ; shift
	local msg="$@"
	logger -p "daemon.$level" -t "$NAME" "$msg"
	echo "[$level] $msg" >&2
}

_info() {
	_log "info" "$@"
}

_err() {
	_log "err" "$@"
}

v2ray_section_validate() {
	uci_validate_section "$NAME" "v2ray" "$1" \
		'enabled:bool:0' \
		'v2ray_file:string' \
		'asset_location:directory' \
		'config_file:file'
}

clear_v2ray_rules() {
	$NFT_BIN delete table inet v2ray 2>/dev/null 
	
	# “抽水马桶”式清理，确保环境幂等性
	while ip rule del fwmark 1 lookup 100 2>/dev/null ; do true ; done
	while ip -6 rule del fwmark 1 lookup 100 2>/dev/null ; do true ; done
	ip route flush table 100 2>/dev/null
	ip -6 route flush table 100 2>/dev/null
	ip route del local 0.0.0.0/0 dev lo table 100 2>/dev/null
	ip -6 route del local ::/0 dev lo table 100 2>/dev/null
}

clear_transparent_proxy() {
	clear_v2ray_rules

	if [ -s "$FILE_V2RAY_DNSMASQ" ] ; then
		_info "Cleaning up old Dnsmasq proxy rules..."
		rm -f "$FILE_V2RAY_DNSMASQ"
		DNSMASQ_RESTART_EXPECTED=1
	fi
}

create_v2ray_ipset() {
	# 保留地址放入 direct，防止内网通信被错误代理
	local reserved_v4="
		0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
		169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
		192.88.99.0/24, 192.168.0.0/16, 192.18.0.0/15, 198.51.100.0/24,
		203.0.113.0/24, 224.0.0.0/4, 240.0.0.0-255.255.255.255
	"
	local reserved_v6="
		::1/128, ::ffff:0:0/96, ::ffff:0:0:0/96, 64:ff9b::/96,
		100::/64, 2001::/32, 2001:20::/28, 2001:db8::/32,
		2002::/16, fc00::/7, fe80::/10, ff00::/8
	"

	$NFT_BIN -f -<<-EOF 
		#!$NFT_BIN -f
		table inet $NAME {
			set $IPSET_DST_DIRECT_V4 { type ipv4_addr; flags interval; auto-merge; elements = { $reserved_v4 }; } 
			set $IPSET_SRC_DIRECT_V4 { type ipv4_addr; flags interval; auto-merge; }
			set $IPSET_DST_PROXY_V4 { type ipv4_addr; flags interval; auto-merge; }
			set $IPSET_DST_DIRECT_V6 { type ipv6_addr; flags interval; auto-merge; elements = { $reserved_v6 }; }
			set $IPSET_DST_PROXY_V6 { type ipv6_addr; flags interval; auto-merge; }
		}
	EOF
}

# 极致高效流式处理 + “懒加载”状态机防崩溃 + IDN安全防线 + Dnsmasq零浪费联动
process_list() {
	local listname="$1"
	local dns_server="$2"
	local set4="$3"
	local set6="$4"
	local filepath="/etc/v2ray/${listname}.txt"

	test -r "$filepath" || return
	
	_info "Fast processing list: $listname.txt"

	local tmp_v4="/tmp/v2ray_v4_${listname}.nft"
	local tmp_v6="/tmp/v2ray_v6_${listname}.nft"

	awk -v dns="$dns_server" -v s4="$set4" -v s6="$set6" -v d_file="$FILE_V2RAY_DNSMASQ_CACHE" \
	    -v f_v4="$tmp_v4" -v f_v6="$tmp_v6" '
	{
		sub(/\r$/, ""); gsub(/^[ \t]+|[ \t]+$/, "");
		if ($0 == "" || $0 ~ /^#/) next;

		# 匹配 IPv4
		if ($0 ~ /^[0-9]{1,3}(\.[0-9]{1,3}){3}(\/[0-9]{1,2})?$/) {
			if (s4 != "") {
				if (!v4_started) { print "add element inet v2ray " s4 " {" > f_v4; v4_started=1 }
				print $0 "," > f_v4
			}
		}
		# 匹配 IPv6
		else if ($0 ~ /^[a-fA-F0-9:]+(\/[0-9]{1,3})?$/ && index($0, ":") > 0) {
			if (s6 != "") {
				if (!v6_started) { print "add element inet v2ray " s6 " {" > f_v6; v6_started=1 }
				print $0 "," > f_v6
			}
		}
		# 验证器：严格域名验证，兼容 IDN Punycode
		else if ($0 ~ /^([0-9a-zA-Z_-]+\.)+[a-zA-Z][a-zA-Z0-9-]*[a-zA-Z0-9]$/) {
			# 1. 生成上游 DNS 分流规则
			if (dns != "") print "server=/" $0 "/" dns >> d_file
			
			# 2. 联动生成 nftset 动态抓取规则，精准下发
			if (s4 != "" && s6 != "") {
				print "nftset=/" $0 "/4#inet#v2ray#" s4 ",6#inet#v2ray#" s6 >> d_file
			} else if (s4 != "") {
				print "nftset=/" $0 "/4#inet#v2ray#" s4 >> d_file
			} else if (s6 != "") {
				print "nftset=/" $0 "/6#inet#v2ray#" s6 >> d_file
			}
		}
	}
	END {
		# 状态机闭合
		if (v4_started) print "}" > f_v4
		if (v6_started) print "}" > f_v6
	}' "$filepath"

	# 一次性将硬编码 IP 注入内核，避免产生空命令崩溃
	if [ -s "$tmp_v4" ] || [ -s "$tmp_v6" ]; then
		cat "$tmp_v4" "$tmp_v6" 2>/dev/null | $NFT_BIN -f - 2>/dev/null
	fi
	rm -f "$tmp_v4" "$tmp_v6"
}

add_v2ray_nftables_tproxy_rules() {
	local ext_args="$1"
	local ext_args6="$2"
	local lan_devices="$3"
	local port="$TRANSPARENT_PROXY_PORT"
	local addition="$TRANSPARENT_PROXY_ADDITION"
	
	test -n "$port" || return

	ip rule add fwmark 1 table 100
	ip route add local 0.0.0.0/0 dev lo table 100
	if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
		ip -6 rule add fwmark 1 table 100
		ip -6 route add local ::/0 dev lo table 100
	fi

	$NFT_BIN -f -<<-EOF
		table inet $NAME {
			# 处理 PREROUTING 流量。捕捉已经建立 TProxy 连接的报文或从 LAN 口进来的全新流量。
			chain divert { 
				type filter hook prerouting priority mangle; policy accept; 
				meta l4proto tcp socket transparent 1 counter meta mark set 1 accept
				$(
					if [ -n "$lan_devices" ]; then
						for device in $lan_devices; do
							echo "iifname $device counter jump v2ray_rules"
						done
					fi
				)
				meta mark 1 counter jump v2ray_rules
			}
			# 局域网设备的流量过滤池
			chain v2ray_rules {
				meta mark 0xff counter return
				ip daddr @$IPSET_DST_DIRECT_V4 counter return
				ip saddr @$IPSET_SRC_DIRECT_V4 counter return
				ip6 daddr @$IPSET_DST_DIRECT_V6 counter return
				meta nfproto ipv4 tcp $ext_args counter tproxy ip to :$port meta mark set 1
				$(
					if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
						echo "meta nfproto ipv6 tcp $ext_args6 counter tproxy ip6 to :$port meta mark set 1"
					fi
				)
				$(
					if [ "$addition" = "udp" ] ; then
						echo "meta nfproto ipv4 udp $ext_args counter tproxy ip to :$port meta mark set 1"
						if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
							echo "meta nfproto ipv6 udp $ext_args6 counter tproxy ip6 to :$port meta mark set 1"
						fi
					fi
				)
			}
			# 路由器本机的流量过滤池
			chain v2ray_output { 
				type route hook output priority mangle; policy accept; 
				meta mark 0xff counter accept
				ip daddr @$IPSET_DST_DIRECT_V4 counter accept
				ip saddr @$IPSET_SRC_DIRECT_V4 counter accept
				ip6 daddr @$IPSET_DST_DIRECT_V6 counter accept
				meta nfproto ipv4 tcp $ext_args counter meta mark set 1
				$(
					if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
						echo "meta nfproto ipv6 tcp $ext_args6 counter meta mark set 1"
					fi
					if [ "$addition" = "udp" ] ; then
						echo "meta nfproto ipv4 udp $ext_args counter meta mark set 1"
						if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
							echo "meta nfproto ipv6 udp $ext_args6 counter meta mark set 1"
						fi
					fi
				)
			}
		}
	EOF
}

gracefully_restart_dnsmasq() {
	if [ "x$DNSMASQ_RESTART_EXPECTED" = "x1" ] && [ -x "/etc/init.d/dnsmasq" ] ; then
		_info "Routing lists updated, restarting Dnsmasq to apply changes..."
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		DNSMASQ_RESTART_EXPECTED=0
	fi
}

init_transparent_proxy() {
	local tp_cfg="main_transparent_proxy"
	local redirect_port redirect_udp ipv6_tproxy

	config_get redirect_port "$tp_cfg" "redirect_port"
	config_get_bool redirect_udp "$tp_cfg" "redirect_udp" "0"
	config_get_bool ipv6_tproxy "$tp_cfg" "ipv6_tproxy" "0"
	
	if [ -n "$redirect_port" ] && ! validate_data "port" "$redirect_port" 2>/dev/null ; then
		_err "Transparent proxy redirect port is invalid: $redirect_port"
		return 1
	fi

	TRANSPARENT_PROXY_PORT="$redirect_port"
	TRANSPARENT_PROXY_IPV6="$ipv6_tproxy"

	if [ "x$redirect_udp" = "x1" ] ; then
		TRANSPARENT_PROXY_ADDITION="udp"
	else
		TRANSPARENT_PROXY_ADDITION=
	fi
}

setup_transparent_proxy() {
	if [ -z "$TRANSPARENT_PROXY_PORT" ] || [ "x$TRANSPARENT_PROXY_EXPECTED" != "x1" ] ; then
		_info "Transparent proxy skipped or disabled."
		return 0
	fi

	local tp_cfg="main_transparent_proxy"
	local lan_ifaces direct_list_dns proxy_list_dns

	config_get lan_ifaces "$tp_cfg" "lan_ifaces"
	config_get direct_list_dns "$tp_cfg" "direct_list_dns"
	config_get proxy_list_dns "$tp_cfg" "proxy_list_dns"

	_info "Setting Transparent Proxy on port: $TRANSPARENT_PROXY_PORT"

	test -n "$NFT_BIN" && $NFT_BIN add table inet $NAME

	create_v2ray_ipset

	# 智能联动：只有开启了 IPv6 TProxy，才要求 Dnsmasq 接管 AAAA 解析记录并下发至 v6 集合
	local set6_proxy=""
	local set6_direct=""
	if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
		set6_proxy="$IPSET_DST_PROXY_V6"
		set6_direct="$IPSET_DST_DIRECT_V6"
	fi

	echo "# AUTO-GENERATED FILE. DO NOT MODIFY." >"$FILE_V2RAY_DNSMASQ_CACHE"

	process_list "directlist" "$direct_list_dns" "$IPSET_DST_DIRECT_V4" "$set6_direct"
	process_list "srcdirectlist" "" "$IPSET_SRC_DIRECT_V4" ""
	process_list "proxylist" "$proxy_list_dns" "$IPSET_DST_PROXY_V4" "$set6_proxy"
	process_list "gfwlist" "$proxy_list_dns" "$IPSET_DST_PROXY_V4" "$set6_proxy"

	local ext_args="ip daddr @$IPSET_DST_PROXY_V4"
	local ext_args6="ip6 daddr @$IPSET_DST_PROXY_V6"

	if [ -s "$FILE_V2RAY_DNSMASQ_CACHE" ] && grep -q -v -E "^$|^#" "$FILE_V2RAY_DNSMASQ_CACHE" 2>/dev/null ; then
		local dir="$(dirname "$FILE_V2RAY_DNSMASQ")"
		test -d "$dir" || mkdir -p "$dir"
		mv "$FILE_V2RAY_DNSMASQ_CACHE" "$FILE_V2RAY_DNSMASQ" 2>/dev/null
		DNSMASQ_RESTART_EXPECTED=1
	fi
	rm -f "$FILE_V2RAY_DNSMASQ_CACHE"

	local lan_devices=""
	if [ -n "$lan_ifaces" ] ; then
		. /lib/functions/network.sh
		local lan device
		for lan in $lan_ifaces ; do
			network_get_device device "$lan"
			if [ -n "$device" ] ; then
				lan_devices="${lan_devices:+$lan_devices }$device"
			fi
		done
		lan_devices=$(echo "$lan_devices" | tr -s ' ' '\n' | sort -u)
	fi
	
	add_v2ray_nftables_tproxy_rules "$ext_args" "$ext_args6" "$lan_devices"
}

start_instance() {
	local section="$1"
	local ver_info
	
	if ! v2ray_section_validate "$section" ; then
		_err "Invalid config section: $section"
		return 1
	fi

	if [ -z "$v2ray_file" ] || [ ! -s "$v2ray_file" ] ; then
		_err "Invalid executable file: $v2ray_file"
		return 1
	fi

	test -x "$v2ray_file" || chmod 755 "$v2ray_file"

	ver_info="$(sh -c "$v2ray_file version 2>/dev/null | head -n1")"
	if [ -z "$ver_info" ] ; then
		ver_info="$(sh -c "$v2ray_file --version 2>/dev/null | head -n1")"
	fi
	CORE="$(echo "$ver_info" | awk '{print $1}')"
	CORE_VER="$(echo "$ver_info" | awk '{print $2}')"
	
	_info "Detected Core: $CORE, Version: $CORE_VER"
	
	uci set v2ray.main.core="$CORE"
	uci commit

	if [ "x$enabled" != "x1" ] ; then
		_info "Instance $section is disabled in config."
		return 0
	fi
	
	if [ -z "$config_file" ] || [ ! -s "$config_file" ] ; then
		_err "Config file not found or empty: $config_file"
		return 1
	fi

	_info "Validating configuration file: $config_file..."

	if [ "$CORE" = "V2Ray" ] && [ "$(expr "$CORE_VER" \< "5")" = "1" ] ; then
		if ! "$v2ray_file" -test -config="$config_file" >/dev/null 2>&1 ; then
			_err "Validate config file failed! Please check $config_file syntax."
			return 1
		fi
	else
		if ! "$v2ray_file" test -c "$config_file" >/dev/null 2>&1 ; then
			_err "Validate config file failed! Please check $config_file syntax."
			return 1
		fi
	fi
	
	_info "Configuration is valid. Booting up instance..."

	TRANSPARENT_PROXY_EXPECTED=1

	procd_open_instance "$NAME.$section"
	procd_set_param command "$v2ray_file"
	
	if [ "$CORE" = "V2Ray" ] && [ "$(expr "$CORE_VER" \< "5")" = "1" ] ; then
		procd_append_param command "-config=$config_file"
	else
		procd_append_param command "run"
		procd_append_param command "-c=$config_file"
	fi
	
	procd_set_param respawn

	if [ -n "$asset_location" ] && [ -d "$asset_location" ] ; then
		procd_set_param env V2RAY_LOCATION_ASSET="$asset_location"
		procd_set_param env XRAY_LOCATION_ASSET="$asset_location"
	fi

	procd_set_param limits nofile="102400 102400"
	procd_append_param limits core="0 0"

	procd_set_param file "$config_file"
	procd_set_param stderr 1 
	procd_set_param stdout 1

	procd_set_param pidfile "/var/run/${NAME}.${section}.pid"
	
	procd_close_instance
}

start_service() {
	_info "Starting V2Ray TProxy Service..."
	
	clear_transparent_proxy
	config_load "$NAME"

	if ! init_transparent_proxy ; then
		gracefully_restart_dnsmasq
		return 1
	fi

	config_foreach start_instance "v2ray"

	setup_transparent_proxy
	gracefully_restart_dnsmasq

	unset TRANSPARENT_PROXY_EXPECTED TRANSPARENT_PROXY_PORT TRANSPARENT_PROXY_ADDITION DNSMASQ_RESTART_EXPECTED
	
	_info "V2Ray Service Initialization Completed."
}

stop_service() {
	if [ "x$action" = "xrestart" ] ; then
		return 0
	fi

	_info "Stopping V2Ray Service and cleaning up rules..."
	clear_transparent_proxy
	gracefully_restart_dnsmasq
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

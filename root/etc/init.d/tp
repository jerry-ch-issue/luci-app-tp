#!/bin/sh /etc/rc.common
#
# Custom V2Ray/Xray Init Script for OpenWrt 21.02
# 核心架构: Firewall3 (iptables + ipset) | 纯 TProxy + 内存流处理 + 强状态机
#

START=99
USE_PROCD=1
NAME=tp

FILE_TP_DNSMASQ=/tmp/dnsmasq.d/$NAME
FILE_TP_DNSMASQ_CACHE=/tmp/$NAME.dnsmasq.cache

CORE=""
CORE_VER=""

# OpenWrt 21.02 核心依赖二进制 (Firewall3)
IPT_BIN=$(command -v iptables)
IP6T_BIN=$(command -v ip6tables)
IPSET_BIN=$(command -v ipset)

IPSET_DST_PROXY_V4=tp_dst_proxy_v4
IPSET_DST_PROXY_V6=tp_dst_proxy_v6
IPSET_SRC_DIRECT_V4=tp_src_direct_v4
IPSET_DST_DIRECT_V4=tp_dst_direct_v4
IPSET_DST_DIRECT_V6=tp_dst_direct_v6

TRANSPARENT_PROXY_EXPECTED=0
TRANSPARENT_PROXY_PORT=""
TRANSPARENT_PROXY_ADDITION=""
TRANSPARENT_PROXY_IPV6=0
DNSMASQ_RESTART_EXPECTED=0

# ==============================================================================
# 模块：可观测性日志引擎 (A级)
# ==============================================================================
_log() {
	local sys_lvl="$1"; shift
	local out_lvl="$1"; shift
	local module="$1"; shift
	local msg="$@"
	logger -p "daemon.$sys_lvl" -t "$NAME" "[$module] $msg"
	local ts=$(date +"%Y-%m-%d %H:%M:%S")
	echo "[$ts] [$out_lvl] [$module] $msg" >&2
}

_info() { _log "info"    "INFO"  "$1" "$2"; }
_warn() { _log "warning" "WARN"  "$1" "$2"; }
_err()  { _log "err"     "ERROR" "$1" "$2"; }

tp_section_validate() {
	uci_validate_section "$NAME" "tp" "$1" \
		'enabled:bool:0' \
		'v2ray_file:string' \
		'asset_location:directory' \
		'config_file:file'
}

# ==============================================================================
# 模块：环境幂等性清理 (fw3 专属适配)
# 边界防御：fw3 需要精确解绑 Mangle 表中的 PREROUTING/OUTPUT 钩子。
# 使用严格统一的 table 100 语法，兼容极简版 Busybox ip 模块。
# ==============================================================================
clear_tp_rules() {
	_info "SYSTEM" "Flushing iptables/ip6tables and ipset rules..."

	# ==============================================================
	# 独家修复：动态寻找并剥离所有指向我们自定义链的规则 (无视网卡名称)
	# ==============================================================
	clean_refs() {
		local cmd="$1"
		local table="$2"
		local chain="$3"
		for target in TP_DIVERT TP_RULES TP_OUTPUT; do
			while true; do
				# 根据行号动态抓取并删除
				local rule_num=$($cmd -t $table -L $chain -n --line-numbers 2>/dev/null | grep -w "$target" | awk '{print $1}' | head -n1)
				[ -z "$rule_num" ] && break
				$cmd -t $table -D $chain $rule_num 2>/dev/null
			done
		done
	}

	# 剥离并清理 IPv4 引用和自定义链
	clean_refs "$IPT_BIN" "mangle" "PREROUTING"
	clean_refs "$IPT_BIN" "mangle" "OUTPUT"
	clean_refs "$IPT_BIN" "nat" "PREROUTING"
	clean_refs "$IPT_BIN" "nat" "OUTPUT"

	# 剥离并清理 IPv6 引用
	if [ -n "$IP6T_BIN" ]; then
		clean_refs "$IP6T_BIN" "mangle" "PREROUTING"
		clean_refs "$IP6T_BIN" "mangle" "OUTPUT"
		clean_refs "$IP6T_BIN" "nat" "PREROUTING"
		clean_refs "$IP6T_BIN" "nat" "OUTPUT"
	fi

	for chain in TP_DIVERT TP_RULES TP_OUTPUT; do
		$IPT_BIN -t mangle -F $chain 2>/dev/null
		$IPT_BIN -t mangle -X $chain 2>/dev/null
		$IPT_BIN -t nat -F $chain 2>/dev/null
		$IPT_BIN -t nat -X $chain 2>/dev/null
		if [ -n "$IP6T_BIN" ]; then
			$IP6T_BIN -t mangle -F $chain 2>/dev/null
			$IP6T_BIN -t mangle -X $chain 2>/dev/null
			$IP6T_BIN -t nat -F $chain 2>/dev/null
			$IP6T_BIN -t nat -X $chain 2>/dev/null
		fi
	done

	# 统一清理路由规则 (解决 Busybox lookup 与 table 语法歧义)
	while ip rule del fwmark 1 table 100 2>/dev/null ; do true ; done
	while ip -6 rule del fwmark 1 table 100 2>/dev/null ; do true ; done
	ip route flush table 100 2>/dev/null
	ip -6 route flush table 100 2>/dev/null
	ip route del local 0.0.0.0/0 dev lo table 100 2>/dev/null
	ip -6 route del local ::/0 dev lo table 100 2>/dev/null

	# 销毁 IPSet 集合
	for setname in $IPSET_DST_PROXY_V4 $IPSET_DST_PROXY_V6 $IPSET_SRC_DIRECT_V4 $IPSET_DST_DIRECT_V4 $IPSET_DST_DIRECT_V6; do
		$IPSET_BIN destroy $setname 2>/dev/null
	done
}

clear_transparent_proxy() {
	clear_tp_rules
	if [ -f "$FILE_TP_DNSMASQ" ] ; then
		_info "CLEANUP" "Purging legacy Dnsmasq rules."
		rm -f "$FILE_TP_DNSMASQ"
		DNSMASQ_RESTART_EXPECTED=1
	fi
}

# ==============================================================================
# 模块：IPSet 集合分配与内存回收 (Timeout 机制)
# 核心防御：追加 -! 标识忽略已存在报错。开启 7天 timeout 防止内存无限膨胀。
# ==============================================================================
create_tp_ipset() {
	local reserved_v4="
		0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8
		169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24
		192.88.99.0/24 192.168.0.0/16 192.18.0.0/15 198.51.100.0/24
		203.0.113.0/24 224.0.0.0/4 240.0.0.0/4 255.255.255.255
	"
	local reserved_v6="
		::1/128 ::ffff:0:0/96 ::ffff:0:0:0/96 64:ff9b::/96
		100::/64 2001::/32 2001:20::/28 2001:db8::/32
		2002::/16 fc00::/7 fe80::/10 ff00::/8
	"
	# [S+级优化]: 利用代码块将创建指令与硬编码 IP 添加指令拼装成一股数据流，
	# 仅需 1 次 ipset restore 进程调用即可完成内核结构的整体初始化。
	{
		echo "create $IPSET_DST_DIRECT_V4 hash:net family inet hashsize 1024 maxelem 65536 timeout 604800"
		echo "create $IPSET_SRC_DIRECT_V4 hash:net family inet hashsize 1024 maxelem 65536"
		echo "create $IPSET_DST_PROXY_V4 hash:net family inet hashsize 1024 maxelem 65536 timeout 604800"
		echo "create $IPSET_DST_DIRECT_V6 hash:net family inet6 hashsize 1024 maxelem 65536 timeout 604800"
		echo "create $IPSET_DST_PROXY_V6 hash:net family inet6 hashsize 1024 maxelem 65536 timeout 604800"
		
		for ip in $reserved_v4; do
			echo "add $IPSET_DST_DIRECT_V4 $ip timeout 0"
		done
		for ip6 in $reserved_v6; do
			echo "add $IPSET_DST_DIRECT_V6 $ip6 timeout 0"
		done
	} | $IPSET_BIN -! restore 2>/dev/null
}

# ==============================================================================
# 模块：流处理注入引擎 (Ipset 高性能适配版)
# ==============================================================================
process_list() {
	local listname="$1"
	local dns_server="$2"
	local set4="$3"
	local set6="$4"
	local filepath="/etc/v2ray/${listname}.txt"

	test -r "$filepath" || return
	_info "PARSER" "Processing routing list: $listname.txt"

	local tmp_ipset="/tmp/tp_ipset_${listname}.txt"

	awk -v dns="$dns_server" -v s4="$set4" -v s6="$set6" -v d_file="$FILE_TP_DNSMASQ_CACHE" \
		-v f_ipset="$tmp_ipset" '
	{
		sub(/\r$/, ""); gsub(/^[ \t]+|[ \t]+$/, "");
		if ($0 == "" || $0 ~ /^#/) next;

		# IPv4 文本直写 IP，赋予 timeout 0 免疫清理
		if ($0 ~ /^[0-9]{1,3}(\.[0-9]{1,3}){3}(\/[0-9]{1,2})?$/) {
			if (s4 != "") print "add " s4 " " $0 " timeout 0" > f_ipset
		}
		# IPv6 文本直写 IP，赋予 timeout 0 免疫清理
		else if ($0 ~ /^[a-fA-F0-9:]+(\/[0-9]{1,3})?$/ && index($0, ":") > 0) {
			if (s6 != "") print "add " s6 " " $0 " timeout 0" > f_ipset
		}
		# 合规域名：利用 Dnsmasq 解析，所查 IP 自动继承集合的 7 天倒计时
		else if ($0 ~ /^([0-9a-zA-Z_-]+\.)+[a-zA-Z][a-zA-Z0-9-]*[a-zA-Z0-9]$/) {
			if (dns != "") print "server=/" $0 "/" dns >> d_file
			
			if (s4 != "" && s6 != "") {
				print "ipset=/" $0 "/" s4 "," s6 >> d_file
			} else if (s4 != "") {
				print "ipset=/" $0 "/" s4 >> d_file
			} else if (s6 != "") {
				print "ipset=/" $0 "/" s6 >> d_file
			}
		}
	}' "$filepath"

	# [致命Bug修复]: -! 强制忽略元素冲突错误，防止 gfwlist 内包含重复 IP 导致整盘挂载崩溃
	if [ -s "$tmp_ipset" ]; then
		cat "$tmp_ipset" 2>/dev/null | $IPSET_BIN -! restore 2>/dev/null
	fi
	rm -f "$tmp_ipset"
}

# ==============================================================================
# 模块：Iptables 透明代理防火墙钩子 (TProxy Hooks)
# 架构解析：全面接管 PREROUTING 与 OUTPUT 链。
# TPROXY target 直接交接流量；打 mark 利用路由表 100 环回给 TProxy。
# ==============================================================================
add_tp_iptables_tproxy_rules() {
	local lan_devices="$1"
	local port="$TRANSPARENT_PROXY_PORT"
	# [修改]: 接收从 UCI 传递过来的全局变量
	local tproxy_port="$TRANSPARENT_TPROXY_PORT"
	local addition="$TRANSPARENT_PROXY_ADDITION"
	
	test -n "$port" || return

	# 1. 暴力关闭所有网卡的 rp_filter (防止一切暗坑)
	for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 > "$i" 2>/dev/null; done

	# ==============================================================
	# 2. IPv4 编排：TCP 走 REDIRECT (Nat 表) -> 发给 1081
	# ==============================================================
	$IPT_BIN -t nat -N TP_RULES
	$IPT_BIN -t nat -A TP_RULES -m mark --mark 0xff -j RETURN
	$IPT_BIN -t nat -A TP_RULES -m set --match-set $IPSET_DST_DIRECT_V4 dst -j RETURN
	$IPT_BIN -t nat -A TP_RULES -m set --match-set $IPSET_SRC_DIRECT_V4 src -j RETURN
	$IPT_BIN -t nat -A TP_RULES -p tcp -m set --match-set $IPSET_DST_PROXY_V4 dst -j REDIRECT --to-ports $port

	if [ -n "$lan_devices" ]; then
		for device in $lan_devices; do
			[ -n "$device" ] && $IPT_BIN -t nat -I PREROUTING -i "$device" -j TP_RULES
		done
	fi

	$IPT_BIN -t nat -N TP_OUTPUT
	$IPT_BIN -t nat -A TP_OUTPUT -m mark --mark 0xff -j RETURN
	$IPT_BIN -t nat -A TP_OUTPUT -m set --match-set $IPSET_DST_DIRECT_V4 dst -j RETURN
	$IPT_BIN -t nat -A TP_OUTPUT -p tcp -m set --match-set $IPSET_DST_PROXY_V4 dst -j REDIRECT --to-ports $port
	$IPT_BIN -t nat -I OUTPUT -j TP_OUTPUT

	# ==============================================================
	# 3. IPv4 编排：UDP 走 TPROXY (Mangle 表) -> 发给 1082
	# ==============================================================
	if [ "$addition" = "udp" ]; then
		ip rule add fwmark 1 table 100 2>/dev/null
		ip route add local 0.0.0.0/0 dev lo table 100 2>/dev/null

		$IPT_BIN -t mangle -N TP_RULES

		$IPT_BIN -t mangle -A TP_RULES -m mark --mark 0xff -j RETURN
		$IPT_BIN -t mangle -A TP_RULES -m set --match-set $IPSET_DST_DIRECT_V4 dst -j RETURN
		$IPT_BIN -t mangle -A TP_RULES -m set --match-set $IPSET_SRC_DIRECT_V4 src -j RETURN
		$IPT_BIN -t mangle -A TP_RULES -p udp -m set --match-set $IPSET_DST_PROXY_V4 dst -j TPROXY --on-port $tproxy_port --on-ip 127.0.0.1 --tproxy-mark 1

		if [ -n "$lan_devices" ]; then
			for device in $lan_devices; do
				[ -n "$device" ] && $IPT_BIN -t mangle -A PREROUTING -i "$device" -j TP_RULES
			done
		fi

		$IPT_BIN -t mangle -N TP_OUTPUT
		$IPT_BIN -t mangle -A TP_OUTPUT -m mark --mark 0xff -j RETURN
		$IPT_BIN -t mangle -A TP_OUTPUT -m set --match-set $IPSET_DST_DIRECT_V4 dst -j RETURN
		$IPT_BIN -t mangle -A TP_OUTPUT -p udp -m set --match-set $IPSET_DST_PROXY_V4 dst -j MARK --set-mark 1
		$IPT_BIN -t mangle -I OUTPUT -j TP_OUTPUT
	fi

	# ==============================================================
	# 4. IPv6 编排：TCP 走 REDIRECT(1081), UDP 走 TPROXY(1082)
	# ==============================================================
	if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] && [ -n "$IP6T_BIN" ] ; then
		# 4.1 IPv6 TCP 彻底切换为 REDIRECT (避开 TProxy TCP 握手丢包死局)
		$IP6T_BIN -t nat -N TP_RULES 2>/dev/null
		if [ $? -eq 0 ]; then
			$IP6T_BIN -t nat -A TP_RULES -m mark --mark 0xff -j RETURN
			$IP6T_BIN -t nat -A TP_RULES -m set --match-set $IPSET_DST_DIRECT_V6 dst -j RETURN
			$IP6T_BIN -t nat -A TP_RULES -p tcp -m set --match-set $IPSET_DST_PROXY_V6 dst -j REDIRECT --to-ports $port

			if [ -n "$lan_devices" ]; then
				for device in $lan_devices; do
					[ -n "$device" ] && $IP6T_BIN -t nat -I PREROUTING -i "$device" -j TP_RULES
				done
			fi

			$IP6T_BIN -t nat -N TP_OUTPUT
			$IP6T_BIN -t nat -A TP_OUTPUT -m mark --mark 0xff -j RETURN
			$IP6T_BIN -t nat -A TP_OUTPUT -m set --match-set $IPSET_DST_DIRECT_V6 dst -j RETURN
			$IP6T_BIN -t nat -A TP_OUTPUT -p tcp -m set --match-set $IPSET_DST_PROXY_V6 dst -j REDIRECT --to-ports $port
			$IP6T_BIN -t nat -I OUTPUT -j TP_OUTPUT
		else
			_warn "SYSTEM" "ip6tables NAT module missing. IPv6 TCP proxy might fail."
		fi

		# 4.2 IPv6 UDP 继续保留 TPROXY (因为 UDP 无握手状态，无 Bug)
		if [ "$addition" = "udp" ]; then
			ip -6 rule add fwmark 1 table 100 2>/dev/null
			ip -6 route add local ::/0 dev lo table 100 2>/dev/null

			$IP6T_BIN -t mangle -N TP_RULES
			$IP6T_BIN -t mangle -A TP_RULES -m mark --mark 0xff -j RETURN
			$IP6T_BIN -t mangle -A TP_RULES -m set --match-set $IPSET_DST_DIRECT_V6 dst -j RETURN
			$IP6T_BIN -t mangle -A TP_RULES -p udp -m set --match-set $IPSET_DST_PROXY_V6 dst -j TPROXY --on-port $tproxy_port --tproxy-mark 1

			if [ -n "$lan_devices" ]; then
				for device in $lan_devices; do
					[ -n "$device" ] && $IP6T_BIN -t mangle -A PREROUTING -i "$device" -j TP_RULES
				done
			fi

			$IP6T_BIN -t mangle -N TP_OUTPUT
			$IP6T_BIN -t mangle -A TP_OUTPUT -m mark --mark 0xff -j ACCEPT
			$IP6T_BIN -t mangle -A TP_OUTPUT -m set --match-set $IPSET_DST_DIRECT_V6 dst -j ACCEPT
			$IP6T_BIN -t mangle -A TP_OUTPUT -p udp -m set --match-set $IPSET_DST_PROXY_V6 dst -j MARK --set-mark 1
			$IP6T_BIN -t mangle -I OUTPUT -j TP_OUTPUT
		fi
	fi
}

gracefully_restart_dnsmasq() {
	if [ "x$DNSMASQ_RESTART_EXPECTED" = "x1" ] && [ -x "/etc/init.d/dnsmasq" ] ; then
		_info "DNSMASQ" "Restarting Dnsmasq to apply routing updates..."
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
		DNSMASQ_RESTART_EXPECTED=0
	fi
}

init_transparent_proxy() {
	local tp_cfg="main_transparent_proxy"
	local redirect_port tproxy_port redirect_udp ipv6_tproxy

	config_get redirect_port "$tp_cfg" "redirect_port"
	# [新增]: 从 UCI 配置中读取独立的 TProxy 端口
	config_get tproxy_port "$tp_cfg" "tproxy_port"
	config_get_bool redirect_udp "$tp_cfg" "redirect_udp" "0"
	config_get_bool ipv6_tproxy "$tp_cfg" "ipv6_tproxy" "0"
	
	if [ -n "$redirect_port" ] && ! validate_data "port" "$redirect_port" 2>/dev/null ; then
		_err "CONFIG" "Invalid transparent proxy port parameter: ${redirect_port}"
		return 1
	fi

	# [新增]: 校验 tproxy_port 的合法性
	if [ -n "$tproxy_port" ] && ! validate_data "port" "$tproxy_port" 2>/dev/null ; then
		_err "CONFIG" "Invalid TProxy port parameter: ${tproxy_port}"
		return 1
	fi

	TRANSPARENT_PROXY_PORT="$redirect_port"
	# [新增]: 导出变量。如果 UCI 中未配置 tproxy_port，默认回退到 1082
	TRANSPARENT_TPROXY_PORT="${tproxy_port:-1082}"
	TRANSPARENT_PROXY_IPV6="$ipv6_tproxy"
	TRANSPARENT_PROXY_ADDITION=$( [ "x$redirect_udp" = "x1" ] && echo "udp" || echo "" )
}

setup_transparent_proxy() {
	if [ -z "$TRANSPARENT_PROXY_PORT" ] || [ "x$TRANSPARENT_PROXY_EXPECTED" != "x1" ] ; then
		_warn "TPROXY" "Prerequisites unmet. Bypassing transparent proxy setup."
		return 0
	fi

	local tp_cfg="main_transparent_proxy"
	local lan_ifaces direct_list_dns proxy_list_dns

	config_get lan_ifaces "$tp_cfg" "lan_ifaces"
	config_get direct_list_dns "$tp_cfg" "direct_list_dns"
	config_get proxy_list_dns "$tp_cfg" "proxy_list_dns"

	_info "TPROXY" "Activating Iptables Transparent Engine on port [${TRANSPARENT_PROXY_PORT}]"

	create_tp_ipset

	local set6_proxy=""
	local set6_direct=""
	if [ "x$TRANSPARENT_PROXY_IPV6" = "x1" ] ; then
		set6_proxy="$IPSET_DST_PROXY_V6"
		set6_direct="$IPSET_DST_DIRECT_V6"
	fi

	echo "# AUTO-GENERATED FILE. DO NOT MODIFY." >"$FILE_TP_DNSMASQ_CACHE"

	process_list "directlist" "$direct_list_dns" "$IPSET_DST_DIRECT_V4" "$set6_direct"
	process_list "srcdirectlist" "" "$IPSET_SRC_DIRECT_V4" ""
	process_list "proxylist" "$proxy_list_dns" "$IPSET_DST_PROXY_V4" "$set6_proxy"
	process_list "gfwlist" "$proxy_list_dns" "$IPSET_DST_PROXY_V4" "$set6_proxy"

	# 原子操作更新 DNSMasq
	if [ -f "$FILE_TP_DNSMASQ_CACHE" ]; then
		# [修复点]: 确保目标目录存在
		mkdir -p "$(dirname "$FILE_TP_DNSMASQ")"

		if cmp -s "$FILE_TP_DNSMASQ_CACHE" "$FILE_TP_DNSMASQ" 2>/dev/null; then
			rm -f "$FILE_TP_DNSMASQ_CACHE"
		else
			mv -f "$FILE_TP_DNSMASQ_CACHE" "$FILE_TP_DNSMASQ" 2>/dev/null
			DNSMASQ_RESTART_EXPECTED=1
		fi
	fi

	local lan_devices=""
	if [ -n "$lan_ifaces" ] ; then
		. /lib/functions/network.sh
		local lan device
		for lan in $lan_ifaces ; do
			network_get_device device "$lan"
			if [ -n "$device" ] ; then
				lan_devices="${lan_devices:+$lan_devices }$device"
			fi
		done
		lan_devices=$(echo "$lan_devices" | tr ' ' '\n' | sort -u | tr '\n' ' ')
	fi
	
	add_tp_iptables_tproxy_rules "$lan_devices"
}

start_instance() {
	local section="$1"
	local ver_info
	
	if ! tp_section_validate "$section" ; then
		_err "SYSTEM" "Validation failed for UCI section: $section"
		return 1
	fi

	if [ -z "$v2ray_file" ] || [ ! -s "$v2ray_file" ] ; then
		_err "SYSTEM" "Missing executable payload: $v2ray_file"
		return 1
	fi

	test -x "$v2ray_file" || chmod 755 "$v2ray_file"

	ver_info="$(sh -c "$v2ray_file version 2>/dev/null | head -n1")"
	if [ -z "$ver_info" ] ; then
		ver_info="$(sh -c "$v2ray_file --version 2>/dev/null | head -n1")"
	fi
	CORE="$(echo "$ver_info" | awk '{print $1}')"
	CORE_VER="$(echo "$ver_info" | awk '{print $2}')"
	
	_info "SYSTEM" "Binary Fingerprint -> Engine: [$CORE] Version: [$CORE_VER]"
	
	uci set tp.main.core="$CORE"
	uci commit

	if [ "x$enabled" != "x1" ] ; then
		return 0
	fi
	
	if [ -z "$config_file" ] || [ ! -s "$config_file" ] ; then
		_err "SYSTEM" "Configuration JSON missing or empty: $config_file"
		return 1
	fi

	local is_v4=0
	if [ "$CORE" = "V2Ray" ] ; then
		local major_ver=$(echo "$CORE_VER" | cut -d'.' -f1 | grep -oE '[0-9]+')
		if [ -n "$major_ver" ] && [ "$major_ver" -lt 5 ] 2>/dev/null ; then
			is_v4=1
		fi
	fi

	if [ "$is_v4" = "1" ] ; then
		if ! "$v2ray_file" -test -config="$config_file" >/dev/null 2>&1 ; then
			_err "SYSTEM" "V4 kernel syntax validation failed for $config_file"
			return 1
		fi
	else
		if ! "$v2ray_file" run -test -c "$config_file" >/dev/null 2>&1 ; then
			_err "SYSTEM" "Xray kernel syntax validation failed for $config_file"
			return 1
		fi
	fi

	TRANSPARENT_PROXY_EXPECTED=1

	procd_open_instance "$NAME.$section"
	procd_set_param command "$v2ray_file"
	
	if [ "$is_v4" = "1" ] ; then
		procd_append_param command "-config=$config_file"
	else
		procd_append_param command "run"
		procd_append_param command "-c=$config_file"
	fi
	
	procd_set_param respawn

	if [ -n "$asset_location" ] && [ -d "$asset_location" ] ; then
		procd_set_param env V2RAY_LOCATION_ASSET="$asset_location"
		procd_set_param env XRAY_LOCATION_ASSET="$asset_location"
	fi

	procd_set_param limits nofile="102400 102400"
	procd_append_param limits core="0 0"

	procd_set_param file "$config_file"
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_set_param pidfile "/var/run/${NAME}.${section}.pid"
	
	procd_close_instance
	_info "SYSTEM" "Instance [$section] passed to Procd supervisor."
}

start_service() {
	_info "BOOT" "=== Initiating V2Ray/Xray Subsystem (fw3) ==="
	
	clear_transparent_proxy
	config_load "$NAME"

	if ! init_transparent_proxy ; then
		gracefully_restart_dnsmasq
		return 1
	fi

	config_foreach start_instance "tp"

	setup_transparent_proxy
	gracefully_restart_dnsmasq

	unset TRANSPARENT_PROXY_EXPECTED TRANSPARENT_PROXY_PORT TRANSPARENT_TPROXY_PORT TRANSPARENT_PROXY_ADDITION DNSMASQ_RESTART_EXPECTED
}

stop_service() {
	if [ "x$action" = "xrestart" ] ; then
		return 0
	fi

	_info "HALT" "=== Tearing down V2Ray/Xray Subsystem (fw3) ==="
	clear_transparent_proxy
	gracefully_restart_dnsmasq
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

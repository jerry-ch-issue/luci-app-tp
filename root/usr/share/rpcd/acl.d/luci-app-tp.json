{
  "luci-app-tp": {
    "description": "Grant access to LuCI app tp",
    "read": {
      "ubus": {
        "luci.tp": [
          "*"
        ]
      },
      "uci": [
        "tp"
      ],
      "file": {
        "/etc/v2ray/*": [
          "read"
        ],
        "/etc/init.d/tp": [
          "exec"
        ]
      }
    },
    "write": {
      "uci": [
        "tp"
      ],
      "file": {
        "/etc/v2ray/*": [
          "write"
        ]
      }
    }
  }
}

#!/bin/sh
#
# Ubus RPC Script for V2Ray / Xray
# 架构: OpenWrt 21.02 | 纯粹的数据透传，杜绝越权动作
#

. /usr/share/libubox/jshn.sh

check_running_status() {
	local pid="$(cat /var/run/v2ray.main.pid 2>/dev/null)"

	# 1. PID 文件不存在
	if [ -z "$pid" ] ; then
		echo '{ "code": 1 }'
		return
	fi

	local file="$(uci -q get v2ray.main.v2ray_file)"
	if [ -z "$file" ] ; then
		echo '{ "code": 2 }'
		return
	fi

	local file_name="$(basename "$file")"

	# [工业级防护] 2. 检查 /proc/$pid 是否存活，且其运行的进程名是否匹配。
	# 避免 PID 回卷 (PID Wraparound) 导致的幽灵进程误判，也规避了 grep 弱匹配的 Bug。
	if [ -d "/proc/$pid" ] ; then
		local proc_name="$(cat /proc/$pid/comm 2>/dev/null)"
		if [ "$proc_name" = "$file_name" ] ; then
			echo '{ "code": 0 }'
			return
		fi
	fi
	
	echo '{ "code": 1 }'
}

get_v2ray_version() {
	local file="$(uci -q get v2ray.main.v2ray_file)"
	[ -z "$file" ] && file="/usr/bin/v2ray"

	if [ ! -s "$file" ] ; then
		echo '{ "code": 1 }'
		return
	fi

	test -x "$file" || chmod +x "$file"

	# [版本嗅探修正] 优先使用现代 v5/Xray 语法，回退兼容 v4
	local version_info="$("$file" version 2>/dev/null | head -n1)"
	if [ -z "$version_info" ] ; then
		version_info="$("$file" -version 2>/dev/null | head -n1)"
	fi
	
	if [ -z "$version_info" ] ; then
		echo '{ "code": 1 }'
		return
	fi

	local core=$(echo "$version_info" | awk '{print $1}')
	local ver=$(echo "$version_info" | awk '{print $2}')
	# 安全提取主版本号
	local major=$(echo "$ver" | cut -d. -f1 | grep -oE '[0-9]+')

	if [ -z "$core" ] || [ -z "$ver" ] ; then
		echo '{ "code": 1 }'
		return
	fi

	case "$core" in
		V2Ray|Xray|xray|v2ray)
			if uci get v2ray.main >/dev/null 2>&1; then
				uci set v2ray.main.core="$core"
				uci set v2ray.main.version="$ver"
				[ -n "$major" ] && uci set v2ray.main.major="$major"
				uci commit v2ray
			fi
			printf '{ "code": 0, "version": "Core: %s, Version: %s" }\n' "$core" "$ver"
		;;
		*)
			echo '{ "code": 1 }'
		;;
	esac
}

get_list_status() {
	local name="$1"

	if [ -z "$name" ] ; then
		echo '{ "code": 128 }'
		return
	fi

	local file="/etc/v2ray/${name}.txt"

	if [ ! -r "$file" ] ; then
		echo '{ "code": 2 }'
		return
	fi

	local count="$(grep -v '^$' "$file" | wc -l)"
	local lastModifyTime="$(date -r "$file" '+%Y/%m/%d %H:%M:%S %Z')"

	printf '{ "code": 0, "count": %d, "datetime": "%s" }\n' "$count" "$lastModifyTime"
}

# 严格的 Ubus 方法分发路由
case "$1" in
	list)
		json_set_namespace "v2ray_list" old_ns
		json_init

		json_add_object "runningStatus"
		json_close_object

		json_add_object "v2rayVersion"
		json_close_object

		json_add_object "listStatus"
		json_add_string "name" "String"
		json_close_object

		json_dump -i
		json_cleanup
		json_set_namespace "$old_ns"
	;;
	call)
		case "$2" in
			runningStatus)
				check_running_status
			;;
			v2rayVersion)
				get_v2ray_version
			;;
			listStatus)
				read input;
				json_set_namespace "v2ray_listStatus" old_ns
				json_load "$input"
				json_get_var list_name "name"
				json_cleanup
				json_set_namespace "$old_ns"

				get_list_status "$list_name"
			;;
		esac
	;;
esac

# 🚨 [致命 Bug 修复] 绝对不能在这里放任何会导致服务重启的代码！
exit 0
